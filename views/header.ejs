<!doctype html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hall Booking Portal</title><link rel="stylesheet" href="/style.css"></head>
<body>
<nav>
  <a class="brand" href="/">🏛 KKWIEER Hall Booking</a>
  <div class="links">
    <a href="/">Home</a>
    <% if (user) { %>
      <a href="/dashboard">Requests</a>
      <a href="/schedule">Weekly Schedule</a>
      <span class="who"><%= user.name %> · <%= user.role === 'incharge' ? 'Hall Incharge' : 'Student' %></span>
      <a href="/logout">Logout</a>
    <% } else { %>
      <a href="/login">Login</a>
      <a class="btn small" href="/register">Register</a>
    <% } %>
  </div>
</nav>
<main>
<% if (error) { %><p class="err"><%= error %></p><% } %>
