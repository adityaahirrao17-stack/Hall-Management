<%- include('header') %>
<% const cnt = s => bookings.filter(b => b.status === s).length; %>
<div class="stats">
  <div class="stat"><b><%= cnt('pending') %></b><span>Pending</span></div>
  <div class="stat"><b><%= cnt('approved') %></b><span>Approved</span></div>
  <div class="stat"><b><%= cnt('rejected') %></b><span>Rejected</span></div>
</div>
<div class="card">
  <h2>My Hall Requests</h2>
  <a class="btn" href="/book">+ New request</a>
  <table style="margin-top:16px">
    <tr><th>Hall</th><th>Activity</th><th>When</th><th>Faculty</th><th>Status</th><th></th></tr>
    <% bookings.forEach(b => { %>
    <tr>
      <td><%= b.hall %></td><td><%= b.activity %></td>
      <td><%= b.event_date.toLocaleDateString('en-GB') %><br><%= b.start_time.slice(0,5) %>–<%= b.end_time.slice(0,5) %></td>
      <td><%= b.faculty_incharge %></td>
      <td><span class="badge <%= b.status %>"><%= b.status %></span><% if (b.remarks) { %><br><small><%= b.remarks %></small><% } %></td>
      <td><% if (b.status === 'approved') { %><a class="btn small" href="/booking/<%= b.id %>/letter" target="_blank">View letter</a><% } %></td>
    </tr>
    <% }) %>
    <% if (!bookings.length) { %><tr><td colspan="6">No requests yet.</td></tr><% } %>
  </table>
</div>
<%- include('footer') %>
